# Copia este archivo a .env.local (o .env) y ajusta los valores.

# Base de datos del proyecto Supabase "MODULA"
# (huqailndoltfygxjczkv, https://huqailndoltfygxjczkv.supabase.co).
# Sácalas de Supabase Dashboard -> Project Settings -> Database -> Connection string.
#
# DATABASE_URL (runtime): en PRODUCCIÓN (Vercel u otro serverless) usa el
# pooler en MODO TRANSACCIÓN (puerto 6543, con ?pgbouncer=true) — es el
# recomendado para muchas funciones concurrentes. En DESARROLLO LOCAL, si
# ese modo se queda colgado sin dar error (problema visto en algunas
# redes/ISP, no del pooler en sí), usa el pooler en modo sesión (puerto
# 5432, sin ?pgbouncer=true) como en el ejemplo de abajo.
DATABASE_URL="postgresql://postgres.huqailndoltfygxjczkv:<TU-PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# DIRECT_URL: conexión directa/sesión usada SOLO por `prisma migrate`
# (el modo transacción no soporta el protocolo que las migraciones
# necesitan). Puede ser la misma que DATABASE_URL si esta ya es modo sesión.
DIRECT_URL="postgresql://postgres.huqailndoltfygxjczkv:<TU-PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# NextAuth
# Genera uno con: npx auth secret
AUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# URL pública de la app, usada para generar el snippet de instalación del
# widget (Plan B). En desarrollo se infiere del host de la solicitud si se
# omite; en producción conviene fijarla explícitamente.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notificaciones por correo (Resend). Opcional en desarrollo: si se omite,
# las notificaciones de nuevas cotizaciones solo se registran en consola.
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL="notificaciones@modula.app"
