# Copia este archivo a .env.local (o .env) y ajusta los valores.

# Base de datos del proyecto Supabase "MODULA"
# (huqailndoltfygxjczkv, https://huqailndoltfygxjczkv.supabase.co).
# Sácalas de Supabase Dashboard -> Project Settings -> Database -> Connection string.
#
# DATABASE_URL (runtime): en PRODUCCIÓN (Vercel u otro serverless) usa el
# pooler en MODO TRANSACCIÓN (puerto 6543, con ?pgbouncer=true) — es el
# recomendado para muchas funciones concurrentes. En DESARROLLO LOCAL, si
# ese modo se queda colgado sin dar error (problema visto en algunas
# redes/ISP, no del pooler en sí), usa el pooler en modo sesión (puerto
# 5432, sin ?pgbouncer=true) como en el ejemplo de abajo.
DATABASE_URL="postgresql://postgres.huqailndoltfygxjczkv:<TU-PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# DIRECT_URL: conexión directa/sesión usada SOLO por `prisma migrate`
# (el modo transacción no soporta el protocolo que las migraciones
# necesitan). Puede ser la misma que DATABASE_URL si esta ya es modo sesión.
DIRECT_URL="postgresql://postgres.huqailndoltfygxjczkv:<TU-PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# NextAuth
# Genera uno con: npx auth secret
AUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# URL pública de la app, usada para generar el snippet de instalación del
# widget (Plan B). En desarrollo se infiere del host de la solicitud si se
# omite; en producción conviene fijarla explícitamente.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notificaciones por correo (Resend). Opcional en desarrollo: si se omite,
# las notificaciones de nuevas cotizaciones solo se registran en consola.
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL="notificaciones@tudominio.com"
DEMO_REQUEST_EMAIL="tu@correo.com"

# Supabase Storage — subida de logos/imágenes de cada desarrollo (bucket
# público "development-media"). SUPABASE_URL es la misma URL del proyecto
# de arriba; la service role key se saca de Supabase Dashboard -> Project
# Settings -> API -> Project API keys -> service_role (secreta, nunca
# usar la anon/publishable aquí porque esta bypassa RLS al subir).
SUPABASE_URL="https://huqailndoltfygxjczkv.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe — facturación real por plan (ver SETUP.md sección "Stripe" para
# la guía completa de cómo probarlo en desarrollo con el Stripe CLI).
# Usa SIEMPRE llaves de modo prueba (sk_test_/pk_test_) en desarrollo.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# La imprime `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."
# IDs de los Price de Stripe (Dashboard -> Product catalog), uno por plan.
STRIPE_PRICE_ID_BASICO=""
STRIPE_PRICE_ID_PROFESIONAL=""

# Dominios personalizados (issue #29) — opcional. Si se omiten, guardar
# un dominio en Integración sigue funcionando, pero el admin tiene que
# conectarlo a mano en Vercel -> Settings -> Domains; con estas dos
# variables, MODULA lo conecta solo vía la API de Vercel al guardarlo.
# VERCEL_API_TOKEN: Vercel -> Account Settings -> Tokens -> Create
# (sin expiración, este token lo usa el servidor de forma continua).
# VERCEL_PROJECT_ID: Vercel -> tu proyecto -> Settings -> General.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
# Solo si el proyecto vive bajo un team de Vercel (no tu cuenta personal).
VERCEL_TEAM_ID=""
