# Copia este archivo a .env.local (o .env) y ajusta los valores.

# Postgres local (ver docker-compose.yml)
DATABASE_URL="postgresql://configurador:configurador@localhost:5432/configurador?schema=public"

# NextAuth
# Genera uno con: npx auth secret
AUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"
