# Copia este archivo a .env.local (o .env) y ajusta los valores.

# Base de datos del proyecto Supabase "MODULA"
# (huqailndoltfygxjczkv, https://huqailndoltfygxjczkv.supabase.co).
# Obtén la cadena real en: Supabase Dashboard -> Project Settings ->
# Database -> Connection string (usa la de "Connection pooling" para
# entornos serverless, o la directa para desarrollo local).
DATABASE_URL="postgresql://postgres:<TU-PASSWORD>@db.huqailndoltfygxjczkv.supabase.co:5432/postgres"

# NextAuth
# Genera uno con: npx auth secret
AUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Notificaciones por correo (Resend). Opcional en desarrollo: si se omite,
# las notificaciones de nuevas cotizaciones solo se registran en consola.
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL="notificaciones@modula.app"
