// Modelo de datos base — Fase 0 (ver README.md sección 8)
// Nombres de modelo en PascalCase, tablas mapeadas a snake_case tal como
// están documentadas en la especificación.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: usado en runtime por la app. En producción (Vercel) debe
// ser el pooler de Supabase en MODO TRANSACCIÓN (puerto 6543,
// ?pgbouncer=true) — el recomendado para serverless. En este entorno de
// desarrollo local específico ese modo se cuelga indefinidamente con
// Prisma (issue "Resolver estrategia de conexión a Postgres para
// despliegue serverless") y se usa el pooler en modo sesión (5432) como
// workaround — probar el modo transacción de nuevo antes de desplegar,
// ya que el problema parece ser de esta red y no del pooler en sí.
//
// DIRECT_URL: conexión directa (o pooler en modo sesión) usada SOLO por
// `prisma migrate` — pgbouncer en modo transacción no soporta el
// protocolo que las migraciones necesitan.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountPlan {
  BASICO
  PROFESIONAL
}

enum BillingStatus {
  TRIAL
  ACTIVO
  MOROSO
  CANCELADO
}

enum DevelopmentStatus {
  BORRADOR
  PUBLICADO
}

enum PromotionType {
  PORCENTAJE
  FIJO
}

enum IntegrationMode {
  HOSPEDADA
  WIDGET
}

enum IntegrationEnv {
  VISTA_PREVIA
  PRODUCCION
}

enum QuoteStatus {
  NUEVA
  CONTACTADA
  CERRADA
}

enum QuoteOrigin {
  A
  B
}

enum AnalyticsEventType {
  VISITA
  CONFIGURACION_COMPLETADA
  COTIZACION_ENVIADA
}

/// UNICA: el comprador elige como máximo una opción de la categoría
/// (radio). MULTIPLE: puede elegir varias (checkbox). Ver issue #58.
enum FinishSelectionMode {
  UNICA
  MULTIPLE
}

/// Cuenta de una desarrolladora inmobiliaria (tenant raíz).
model Account {
  id                   String        @id @default(cuid())
  name                 String
  plan                 AccountPlan   @default(BASICO)
  billingStatus        BillingStatus @default(TRIAL)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  developments Development[]
  members      Member[]
  roles        Role[]

  @@map("accounts")
}

/// Rol personalizado por cuenta (issue #72): el admin define el nombre y
/// qué permisos incluye (ver src/lib/permissions.ts para las claves
/// válidas), en vez de un enum fijo de 3 valores. Cada cuenta parte de 3
/// roles semilla (Administrador/Editor de catálogo/Solo lectura,
/// editables como cualquier otro) creados en el registro.
model Role {
  id          String   @id @default(cuid())
  accountId   String
  name        String
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  members Member[]

  @@index([accountId])
  @@map("roles")
}

/// Usuario del dashboard, miembro del equipo de una desarrolladora.
/// Es también la entidad de autenticación (credenciales locales).
model Member {
  id           String   @id @default(cuid())
  accountId    String
  roleId       String
  name         String
  email        String   @unique
  passwordHash String
  /// Se incrementa al cambiar la contraseña; el JWT de sesión guarda el
  /// valor vigente al momento del login y se compara en cada request
  /// (ver src/auth.config.ts) — así un token ya emitido deja de ser
  /// válido apenas cambia la contraseña, sin esperar su expiración.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role               Role                @relation(fields: [roleId], references: [id])
  verificationTokens VerificationToken[]

  @@index([accountId])
  @@index([roleId])
  @@map("members")
}

/// Tokens de un solo uso para recuperar contraseña (#61) y confirmar
/// cambio de correo (#63) — se guarda el hash, nunca el token en claro,
/// mismo principio que una contraseña.
enum VerificationTokenType {
  PASSWORD_RESET
  EMAIL_CHANGE
}

model VerificationToken {
  id        String                @id @default(cuid())
  memberId  String
  type      VerificationTokenType
  tokenHash String                @unique
  /// Para EMAIL_CHANGE: el correo nuevo pendiente de confirmar.
  payload   String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("verification_tokens")
}

/// Un desarrollo inmobiliario dentro de una cuenta (1 cuenta -> N desarrollos).
model Development {
  id             String            @id @default(cuid())
  accountId      String
  name           String
  slug           String            @unique
  description    String?
  status         DevelopmentStatus @default(BORRADOR)
  currency       String            @default("MXN")
  logoUrl        String?
  primaryColor   String?
  accentColor    String?
  ctaText        String?
  webhookUrl     String?
  customDomain           String?   @unique
  customDomainToken      String?
  customDomainVerifiedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  models              Model[]
  catalogNodes        CatalogNode[]
  promotions          Promotion[]
  integrationSettings IntegrationSettings?
  quotes              Quote[]
  analyticsEvents     AnalyticsEvent[]

  @@index([accountId])
  @@map("developments")
}

/// Modelo de vivienda dentro de un desarrollo.
model Model {
  id            String   @id @default(cuid())
  developmentId String
  name          String
  description   String?
  areaM2        Decimal  @db.Decimal(10, 2)
  bedrooms      Int
  basePrice     Decimal  @db.Decimal(14, 2)
  active        Boolean  @default(true)
  imageUrls     String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  development Development  @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  nodeLinks   CatalogNodeModel[]
  quotes      Quote[]

  @@index([developmentId])
  @@map("models")
}

/// Nodo del catálogo de opciones de un desarrollo: un árbol de hasta 5
/// niveles (MAX_CATALOG_DEPTH en src/lib/planLimits.ts) que reemplaza a
/// las antiguas "categorías de acabado" y "extras".
///  - Raíz (parentId null): categoría, siempre una sección, nunca se
///    elige ni cobra por sí misma.
///  - Con hijos: subcategoría; `selectionMode` dice cómo elige el
///    comprador entre sus opciones directas (UNICA/MULTIPLE).
///  - Sin hijos y no raíz: opción elegible, con `priceDelta`.
/// `restrictToModels` + `modelLinks`: si es true, el nodo (y todo lo que
/// cuelga de él) solo se ofrece a esos modelos; es un flag explícito
/// (no "sin filas = todos") para que borrar un modelo no publique el
/// nodo a todos los demás por accidente.
model CatalogNode {
  id               String              @id @default(cuid())
  developmentId    String
  parentId         String?
  name             String
  description      String?
  priceDelta       Decimal             @default(0) @db.Decimal(14, 2)
  imageUrls        String[]            @default([])
  selectionMode    FinishSelectionMode @default(UNICA)
  order            Int                 @default(0)
  restrictToModels Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  development Development        @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  parent      CatalogNode?        @relation("CatalogTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    CatalogNode[]       @relation("CatalogTree")
  modelLinks  CatalogNodeModel[]

  @@index([developmentId])
  @@index([parentId])
  @@map("catalog_nodes")
}

/// Tabla puente N a N entre CatalogNode y Model (modelos a los que aplica
/// un nodo con `restrictToModels`).
model CatalogNodeModel {
  nodeId  String
  modelId String

  node  CatalogNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  model Model       @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([nodeId, modelId])
  @@map("catalog_node_model")
}

/// Promoción/regla de precio con vigencia.
/// Promociones tipo cupón: el comprador debe teclear `code` en el
/// configurador para que se aplique — nunca se aplican solas por fecha
/// (issue "promociones con código, no automáticas").
model Promotion {
  id            String        @id @default(cuid())
  developmentId String
  name          String
  code          String
  type          PromotionType
  value         Decimal       @db.Decimal(14, 2)
  startDate     DateTime
  endDate       DateTime
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  development Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@unique([developmentId, code])
  @@index([developmentId])
  @@index([developmentId, active, startDate, endDate])
  @@map("promotions")
}

/// Configuración de integración (Plan B): snippet, entorno, dominios, token.
/// 1 a 1 con Development.
model IntegrationSettings {
  id                 String          @id @default(cuid())
  developmentId      String          @unique
  mode               IntegrationMode @default(HOSPEDADA)
  environment        IntegrationEnv  @default(VISTA_PREVIA)
  token              String          @unique
  authorizedDomains  String[]        @default([])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  development Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@map("integration_settings")
}

/// Cotización (lead) generada por un comprador final.
model Quote {
  id              String      @id @default(cuid())
  developmentId   String
  modelId         String
  finishOptionIds String[]    @default([])
  extraIds        String[]    @default([])
  total           Decimal     @db.Decimal(14, 2)
  customerName    String
  customerEmail   String
  customerPhone   String
  status          QuoteStatus @default(NUEVA)
  originPlan      QuoteOrigin
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  development Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  model       Model       @relation(fields: [modelId], references: [id])

  @@index([developmentId])
  @@index([developmentId, status])
  @@map("quotes")
}

/// Evento de analítica propio (README.md sección 6.1 y 10): visitas al
/// configurador, configuraciones completadas y cotizaciones enviadas.
model AnalyticsEvent {
  id            String             @id @default(cuid())
  developmentId String
  type          AnalyticsEventType
  originPlan    QuoteOrigin
  modelId       String?
  createdAt     DateTime           @default(now())

  development Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@index([developmentId, type])
  @@map("analytics_events")
}
